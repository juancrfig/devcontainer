{
	"build": {
		"context": "..",
		"dockerfile": "Dockerfile"
	},
	"containerEnv": {
		"SSH_AUTH_SOCK": "/ssh-agent"
	},
	"remoteEnv": {
		"PATH": "/home/vscode/.local/bin:/home/vscode/.local/share/mise/shims:${containerEnv:PATH}"
	},
	"mounts": [
		"source=${localEnv:SSH_AUTH_SOCK},target=/ssh-agent,type=bind",
		"source=${localWorkspaceFolder},target=/repo,type=bind",
		"source=github-copilot,target=/home/vscode/.config/github-copilot,type=volume"
	],
	"workspaceMount": "source=${localEnv:HOME}/workspaces,target=/workspaces,type=bind",
	"workspaceFolder": "/workspaces",
	"postCreateCommand": "/repo/scripts/setup",
	"customizations": {
		"vscode": {
			"settings": {
				"workbench.colorCustomizations": {
					"terminal.background": "#fefae0",
					"terminal.foreground": "#283618"
				}
			}
		}
	}
}
