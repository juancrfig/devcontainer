{
	"build": {
		"context": "..",
		"dockerfile": "Dockerfile"
	},
	"containerEnv": {
		"SSH_AUTH_SOCK": "/ssh-agent"
	},
	"remoteEnv": {
		"PATH": "/home/juanes/.local/bin:/home/juanes/.local/share/mise/shims:${containerEnv:PATH}"
	},
	"mounts": [
		"source=${localEnv:SSH_AUTH_SOCK},target=/ssh-agent,type=bind",
		"source=${localWorkspaceFolder},target=/repo,type=bind",
		"source=github-copilot,target=/home/juanes/.config/github-copilot,type=volume"
	],
	"workspaceMount": "source=${localEnv:HOME}/workspaces,target=/workspaces,type=bind",
	"workspaceFolder": "/workspaces",
	"remoteUser": "juanes",
	"containerUser": "juanes",
	"postCreateCommand": "/repo/scripts/setup",
	"customizations": {
		"vscode": {
			"settings": {
				"workbench.colorCustomizations": {
					"terminal.background": "#fefae0",
					"terminal.foreground": "#283618",
					"terminal.ansiBlack": "#283618",
					"terminal.ansiRed": "#a8422f",
					"terminal.ansiGreen": "#606c38",
					"terminal.ansiYellow": "#dda15e",
					"terminal.ansiBlue": "#5d6f8a",
					"terminal.ansiMagenta": "#8a5a6b",
					"terminal.ansiCyan": "#5f8a7d",
					"terminal.ansiWhite": "#d6cfa8",
					"terminal.ansiBrightBlack": "#4d5a35",
					"terminal.ansiBrightRed": "#c65a3f",
					"terminal.ansiBrightGreen": "#818e4f",
					"terminal.ansiBrightYellow": "#bc6c25",
					"terminal.ansiBrightBlue": "#7688a3",
					"terminal.ansiBrightMagenta": "#a5717f",
					"terminal.ansiBrightCyan": "#79a696",
					"terminal.ansiBrightWhite": "#fefae0"
				}
			}
		}
	}
}
