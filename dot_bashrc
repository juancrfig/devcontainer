#!/bin/bash

if ! command -v devpod >/dev/null; then
	echo "Installing DevPod..."
	(curl -L -o devpod "https://github.com/loft-sh/devpod/releases/latest/download/devpod-linux-amd64" && sudo install -c -m 0755 devpod /usr/local/bin && rm -f devpod) >/tmp/setup.log 2>&1
	devpod ide use none
	if [ $? -ne 0 ]; then
		echo "Installation failed. Details: /tmp/setup.log"
	fi
fi

if [ -z "$SSH_AUTH_SOCK" ]; then
	eval "$(ssh-agent -s)" >/dev/null
	ssh-add ~/.ssh/id_ed25519 2>/dev/null
fi

set -o vi

# `devpod ssh` always starts in /workspaces/<workspace id>, ignoring
# workspaceFolder. Land on the workspaces root instead, but only in the
# session's first shell so subshells and tmux panes keep their directory.
if [ -z "$WORKSPACES_LANDED" ] && [ -n "$DEVPOD_WORKSPACE_ID" ] &&
	[ "$PWD" = "/workspaces/$DEVPOD_WORKSPACE_ID" ]; then
	cd /workspaces
fi
export WORKSPACES_LANDED=1

# Advertise 24-bit ("truecolor") support so apps (nvim, bat, delta, fzf,
# git pagers, ...) emit exact RGB escape codes instead of quantizing to a
# 256-color approximation. Only meaningful if the host terminal actually
# renders truecolor; run `theme test` to check.
export COLORTERM=truecolor

if [ -f "$HOME/.config/theme/theme.sh" ]; then
	source "$HOME/.config/theme/theme.sh"
fi

# The stock Ubuntu .bashrc normally defines this; ours replaces it entirely,
# so pick it back up here to auto-colorize plain `ls` with LS_COLORS above.
alias ls='ls --color=auto'

eval "$(mise activate bash)"
eval "$(starship init bash)"

alias v='nvim'
